{
  "manifest_version": 3,
  "name": "Pi Light Explicit Tab",
  "version": "0.2.0",
  "description": "Temporary local bridge for one toolbar-selected browser tab.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "tabs", "scripting", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Pi Light: bind this tab (click again to unbind)" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:19339" }
}
