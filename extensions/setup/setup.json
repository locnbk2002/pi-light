{
  "agentkit": {
    "kit": "engineer",
    "target": "pi",
    "version": "3.1.0-beta.5",
    "skills": [
      "ak-brainstorm", "ak-plan", "ak-cook", "ak-fix", "ak-debug", "ak-test", "ak-code-review",
      "ak-scout", "ak-journal", "ak-docs", "ak-research", "ak-docs-seeker", "ak-git",
      "ak-frontend-design", "ak-frontend-development", "ak-backend-development", "ak-web-frameworks",
      "ak-web-testing", "ak-ui-styling", "ak-databases", "ak-security"
    ]
  },
  "packages": [
    "npm:pi-effort",
    "git:github.com/elidickinson/pi-claude-bridge",
    "git:github.com/modem-dev/pi-herdr-subagents@2489019ea678f0b7e3437727a0a5ca15d4cbe9c1",
    "npm:@gotgenes/pi-permission-system"
  ],
  "permissions": {
    "configPath": "extensions/pi-permission-system/config.json",
    "policy": {
      "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
      "yoloMode": false,
      "permission": {
        "*": "allow",
        "external_directory_read": {"*": "allow"},
        "external_directory_write": {"*": "ask", "/tmp": "allow", "/tmp/*": "allow"},
        "path": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow",
          "*.envrc": "deny",
          "~/.ssh/id_*": "deny",
          "~/.ssh/id_*.pub": "allow",
          "~/.gnupg/*": "deny",
          "~/.pi/agent/auth.json": "deny",
          "~/.claude/.credentials*": "deny",
          "~/.codex/auth.json": "deny",
          "~/.config/gh/hosts.yml": "deny",
          "~/.local/share/keyrings/*": "deny",
          "~/Library/Keychains/*": "deny",
          "~/Library/Cookies/*": "deny",
          "~/Library/Application Support/*/Login Data*": "deny",
          "~/Library/Application Support/*/Cookies*": "deny",
          "~/Library/Application Support/glab-cli/config.yml": "deny",
          "~/Library/Application Support/gh/hosts.yml": "deny"
        },
        "bash": {
          "*": "allow",
          "rm *": "allow",
          "rm *$*": "ask",
          "rm *`*": "ask",
          "rm -rf /": "deny",
          "rm -fr /": "deny",
          "rm /": "deny",
          "rm * /": "deny",
          "rm -rf ~": "deny",
          "rm -rf ~/": "deny",
          "rm *--no-preserve-root*": "deny",
          "cd *$*": "ask",
          "shred *": "ask",
          "curl *": "ask",
          "curl *://*://*": "ask",
          "curl *://*@*": "ask",
          "curl *--resolve*": "ask",
          "curl *--connect-to*": "ask",
          "curl *--proxy*": "ask",
          "curl -x*": "ask",
          "curl * -x*": "ask",
          "curl *--config*": "ask",
          "curl *--preproxy*": "ask",
          "curl -K*": "ask",
          "curl * -K*": "ask",
          "wget *": "ask",
          "wget *://localhost:*": "allow",
          "wget *://127.0.0.1:*": "allow",
          "sh -*": "ask",
          "bash -*": "ask",
          "zsh -*": "ask",
          "bash -n *": "allow",
          "nc *": "ask",
          "ncat *": "ask",
          "socat *": "ask",
          "telnet *": "ask",
          "git push*": "ask",
          "git -C * push*": "ask",
          "git --git-dir=* push*": "ask",
          "git reset --hard*": "ask",
          "git clean *": "ask",
          "git checkout -- *": "ask",
          "git checkout .": "ask",
          "git checkout * -- *": "ask",
          "git switch --discard-changes*": "ask",
          "git restore *": "ask",
          "git stash drop*": "ask",
          "git stash clear*": "ask",
          "git branch -D *": "ask",
          "git filter-branch*": "ask",
          "git filter-repo*": "ask",
          "git reflog expire*": "ask",
          "git -C * stash drop*": "ask",
          "git -C * stash clear*": "ask",
          "git -C * branch -D *": "ask",
          "git -C * filter-branch*": "ask",
          "git -C * filter-repo*": "ask",
          "git -C * reflog expire*": "ask",
          "git -C * switch --discard-changes*": "ask",
          "git --git-dir=* stash drop*": "ask",
          "git --git-dir=* stash clear*": "ask",
          "git --git-dir=* branch -D *": "ask",
          "git --git-dir=* filter-branch*": "ask",
          "git --git-dir=* filter-repo*": "ask",
          "git --git-dir=* reflog expire*": "ask",
          "git --git-dir=* switch --discard-changes*": "ask",
          "git -C * reset --hard*": "ask",
          "git -C * clean*": "ask",
          "git -C * checkout -- *": "ask",
          "git -C * restore *": "ask",
          "git --git-dir=* reset --hard*": "ask",
          "git --git-dir=* clean*": "ask",
          "git --git-dir=* checkout*": "ask",
          "git --git-dir=* restore *": "ask",
          "gh pr create*": "ask",
          "gh pr merge*": "ask",
          "gh pr close*": "ask",
          "gh pr comment*": "ask",
          "gh pr review*": "ask",
          "gh issue create*": "ask",
          "gh issue comment*": "ask",
          "gh issue close*": "ask",
          "gh repo create*": "ask",
          "gh repo delete*": "ask",
          "gh release create*": "ask",
          "gh release delete*": "ask",
          "gh release edit*": "ask",
          "gh release upload*": "ask",
          "gh release delete-asset*": "ask",
          "gh api *-X*": "ask",
          "gh api *--method*": "ask",
          "gh api *-f*": "ask",
          "gh api *-F*": "ask",
          "gh api *--field*": "ask",
          "gh api *--raw-field*": "ask",
          "gh api *--input*": "ask",
          "glab mr create*": "ask",
          "glab mr merge*": "ask",
          "glab mr approve*": "ask",
          "glab mr close*": "ask",
          "glab mr note*": "ask",
          "glab mr update*": "ask",
          "glab mr delete*": "ask",
          "glab issue create*": "ask",
          "glab issue note*": "ask",
          "glab issue close*": "ask",
          "glab repo create*": "ask",
          "glab repo delete*": "ask",
          "glab release *": "ask",
          "glab release list*": "allow",
          "glab release view*": "allow",
          "glab ci run*": "ask",
          "glab ci retry*": "ask",
          "glab ci cancel*": "ask",
          "glab ci delete*": "ask",
          "glab api *-X*": "ask",
          "glab api *--method*": "ask",
          "glab api *-f*": "ask",
          "glab api *-F*": "ask",
          "glab api *--field*": "ask",
          "glab api *--raw-field*": "ask",
          "glab api *--input*": "ask",
          "sudo *": "ask",
          "doas *": "ask",
          "pkexec *": "ask",
          "su *": "ask",
          "yay *": "ask",
          "yay -Q*": "allow",
          "yay -Ss *": "allow",
          "paru *": "ask",
          "paru -Q*": "allow",
          "paru -Ss *": "allow",
          "npm i -g*": "ask",
          "npm install -g*": "ask",
          "pnpm add -g*": "ask",
          "pip install *": "ask",
          "reboot*": "ask",
          "poweroff*": "ask",
          "shutdown*": "ask",
          "halt*": "ask",
          "systemctl *reboot*": "ask",
          "systemctl *poweroff*": "ask",
          "systemctl *halt*": "ask",
          "systemctl *suspend*": "ask",
          "systemctl *hibernate*": "ask",
          "loginctl terminate*": "ask",
          "loginctl kill*": "ask",
          "hyprctl dispatch *exit*": "ask",
          "hyprctl reload full-reset*": {"action": "deny", "reason": "Segfaults Hyprland 0.56.2; use plain hyprctl reload"},
          "killall *Hyprland*": "ask",
          "pkill *Hyprland*": "ask",
          "crontab -r*": "ask",
          "dd *": "ask",
          "mkfs*": "ask",
          "wipefs *": "ask",
          "fdisk *": "ask",
          "sgdisk *": "ask",
          "parted *": "ask",
          "cryptsetup *": "ask",
          "blkdiscard *": "ask",
          "bootctl *": "ask",
          "efibootmgr *": "ask",
          "grub-install*": "ask",
          "mkinitcpio *": "ask",
          "diskutil *": "ask",
          "diskutil list*": "allow",
          "diskutil info *": "allow",
          "diskutil apfs list*": "allow",
          "hdiutil *": "ask",
          "hdiutil info*": "allow",
          "asr *": "ask",
          "bless *": "ask",
          "nvram *": "ask",
          "nvram -p*": "allow",
          "csrutil *": "ask",
          "csrutil status*": "allow",
          "fdesetup *": "ask",
          "fdesetup status*": "allow",
          "spctl *": "ask",
          "spctl --status*": "allow",
          "spctl --assess*": "allow",
          "spctl -a *": "allow",
          "tccutil *": "ask",
          "kmutil *": "ask",
          "kextload *": "ask",
          "kextunload *": "ask",
          "security *": "ask",
          "security dump-keychain*": {"action": "deny", "reason": "Dumps keychain secrets"},
          "osascript *": "ask",
          "pbpaste*": "ask",
          "launchctl *": "ask",
          "launchctl list*": "allow",
          "launchctl print*": "allow",
          "defaults write*": "ask",
          "defaults delete*": "ask",
          "defaults import*": "ask",
          "dscl * -create*": "ask",
          "dscl * -delete*": "ask",
          "dscl * -append*": "ask",
          "dscl * -passwd*": "ask",
          "dscl * -change*": "ask",
          "sysadminctl *": "ask",
          "dseditgroup *": "ask",
          "systemsetup *": "ask",
          "systemsetup -get*": "allow",
          "scutil --set*": "ask",
          "networksetup -set*": "ask",
          "networksetup -remove*": "ask",
          "networksetup -delete*": "ask",
          "pmset *": "ask",
          "pmset -g*": "allow",
          "softwareupdate *": "ask",
          "softwareupdate -l*": "allow",
          "softwareupdate --list*": "allow",
          "tmutil delete*": "ask",
          "tmutil disable*": "ask",
          "tmutil deletelocalsnapshots*": "ask",
          "tmutil thinlocalsnapshots*": "ask",
          "mdutil -E*": "ask",
          "mdutil -i *": "ask",
          "xattr *-d*com.apple.quarantine*": "ask",
          "xattr *-c*": "ask",
          "codesign --remove-signature*": "ask",
          "killall Finder*": "ask",
          "killall Dock*": "ask",
          "killall SystemUIServer*": "ask",
          "killall *WindowServer*": "ask",
          "killall *loginwindow*": "ask",
          "pkill *WindowServer*": "ask",
          "pkill *loginwindow*": "ask",
          "brew *": "ask",
          "brew list*": "allow",
          "brew ls*": "allow",
          "brew info*": "allow",
          "brew search*": "allow",
          "brew deps*": "allow",
          "brew uses*": "allow",
          "brew outdated*": "allow",
          "brew --prefix*": "allow",
          "brew --version*": "allow",
          "brew --cellar*": "allow",
          "brew config*": "allow",
          "brew doctor*": "allow",
          "brew leaves*": "allow",
          "brew desc*": "allow",
          "brew home*": "allow",
          "brew services list*": "allow",
          "brew services info*": "allow",
          "rsync *:*": "ask",
          "scp *": "ask",
          "sftp *": "ask",
          "ssh *": "ask"
        }
      }
    },
    "curlSafeHosts": ["localhost", "127.0.0.1", "[::1]", "api.github.com", "raw.githubusercontent.com", "registry.npmjs.org", "api.npmjs.org", "context7.com", "archlinux.org", "wiki.archlinux.org", "aur.archlinux.org"],
    "sshRead": {
      "withArgs": ["cat", "head", "tail", "grep", "find", "stat", "du"],
      "prefix": ["ls", "df", "ps"],
      "exact": ["uptime"]
    },
    "sshAskLast": ["ssh *;*", "ssh *&*", "ssh *|*", "ssh *>*", "ssh *<*", "ssh *`*", "ssh *$*", "ssh *\\*", "ssh *[*",
      "ssh *'*", "ssh *\"*", "ssh * sudo *",
      "ssh * find *-delete*", "ssh * find *-exec*", "ssh * find *-ok*", "ssh * find *-fprint*", "ssh * find *-fls*"]
  },
  "herdr": {
    "integration": "pi",
    "plugin": { "id": "pi-herdr-subagents", "package": "git:github.com/modem-dev/pi-herdr-subagents", "dir": "herdr-plugin" }
  }
}
