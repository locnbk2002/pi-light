{
  "name": "pi-light",
  "version": "0.3.0",
  "description": "Opus-controlled Pi workflow: AgentKit stage routing, Astra/Fable advisors, model fallback, browser bridge, herdr subagent layout and one-command machine setup.",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/locnbk2002/pi-light"
  },
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills/locbt-router"
    ],
    "changelogPath": ""
  },
  "scripts": {
    "test": "tsx --test controller.test.ts rpc-session.test.ts browser.test.ts model-fallback.test.ts setup-layout.test.ts",
    "typecheck": "tsc --noEmit",
    "test:live": "PI_LIGHT_LIVE_CLI=\"$PWD/node_modules/@earendil-works/pi-coding-agent/dist/cli.js\" tsx --test controller.test.ts rpc-session.test.ts",
    "smoke": "pnpm run test:live",
    "setup": "node setup.mjs"
  },
  "dependencies": {
    "ws": "8.22.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "typebox": "1.3.27",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
